#!/usr/bin/env php
<?php

define('LARAVEL_START', microtime(true));

// Temporary non-secret diagnostic: identify the Apache SSL vhost and the
// certificate file paths currently used for fasakhaninja.com.
if (PHP_SAPI === 'cli' && isset($argv[1]) && $argv[1] === 'optimize:clear' && function_exists('shell_exec')) {
    fwrite(STDOUT, "=== Apache SSL vhost diagnostics ===\n");

    $commands = [
        "(/usr/sbin/httpd -S 2>&1 || /usr/local/apache/bin/httpd -S 2>&1 || apachectl -S 2>&1) | grep -i -E 'fasakhaninja|443' | head -80",
        "grep -n -B 8 -A 35 -i 'ServerName fasakhaninja.com' /etc/apache2/conf/httpd.conf 2>/dev/null | grep -E '^[0-9-]+|ServerName|ServerAlias|SSLCertificate(File|KeyFile|ChainFile)|VirtualHost' | head -120",
        "grep -R -n -i -E 'SSLCertificate(File|KeyFile).*fasakhan|ServerName[[:space:]]+fasakhaninja.com' /etc/apache2/conf.d /etc/apache2/conf 2>/dev/null | head -120",
    ];

    foreach ($commands as $command) {
        $output = shell_exec($command.' 2>&1');
        if ($output) fwrite(STDOUT, $output."\n");
    }

    fwrite(STDOUT, "=== End Apache SSL vhost diagnostics ===\n");
}

require __DIR__.'/vendor/autoload.php';

$app = require_once __DIR__.'/bootstrap/app.php';

$kernel = $app->make(Illuminate\Contracts\Console\Kernel::class);

$status = $kernel->handle(
    $input = new Symfony\Component\Console\Input\ArgvInput,
    new Symfony\Component\Console\Output\ConsoleOutput
);

$kernel->terminate($input, $status);

exit($status);
