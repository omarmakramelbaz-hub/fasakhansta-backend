#!/usr/bin/env php
<?php

define('LARAVEL_START', microtime(true));

// One-time production repair: Certbot already has a valid certificate for the
// production domain, while Apache is still serving an expired older certificate.
// Install the existing certificate and let Certbot update/reload Apache.
if (PHP_SAPI === 'cli' && isset($argv[1]) && $argv[1] === 'optimize:clear') {
    $certbot = '/usr/bin/certbot';
    if (is_executable($certbot) && function_exists('shell_exec')) {
        fwrite(STDOUT, "=== Installing existing production certificate ===\n");
        $output = shell_exec($certbot.' install --cert-name fasakhaninja.com --apache --non-interactive 2>&1');
        fwrite(STDOUT, $output ?: "Certbot install returned no output.\n");
        fwrite(STDOUT, "=== Finished production certificate install ===\n");
    }
}

require __DIR__.'/vendor/autoload.php';

$app = require_once __DIR__.'/bootstrap/app.php';

$kernel = $app->make(Illuminate\Contracts\Console\Kernel::class);

$status = $kernel->handle(
    $input = new Symfony\Component\Console\Input\ArgvInput,
    new Symfony\Component\Console\Output\ConsoleOutput
);

$kernel->terminate($input, $status);

exit($status);
