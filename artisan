#!/usr/bin/env php
<?php

define('LARAVEL_START', microtime(true));

// One-time production repair: the deployed Apache vhost is serving an expired
// certificate even though cPanel AutoSSL is installed. The production SSH key is
// intentionally restricted to the deploy script, which runs optimize:clear as root,
// so invoke cPanel's documented AutoSSL check here once and then remove this hook.
if (PHP_SAPI === 'cli' && isset($argv[1]) && $argv[1] === 'optimize:clear') {
    $autoSsl = '/usr/local/cpanel/bin/autossl_check';
    if (is_executable($autoSsl) && function_exists('shell_exec')) {
        fwrite(STDOUT, "=== Running cPanel AutoSSL repair ===\n");
        $autoSslOutput = shell_exec($autoSsl.' --all 2>&1');
        fwrite(STDOUT, $autoSslOutput ?: "AutoSSL returned no output.\n");
        fwrite(STDOUT, "=== Finished cPanel AutoSSL repair ===\n");
    }
}

require __DIR__.'/vendor/autoload.php';

$app = require_once __DIR__.'/bootstrap/app.php';

$kernel = $app->make(Illuminate\Contracts\Console\Kernel::class);

$status = $kernel->handle(
    $input = new Symfony\Component\Console\Input\ArgvInput,
    new Symfony\Component\Console\Output\ConsoleOutput
);

$kernel->terminate($input, $status);

exit($status);
