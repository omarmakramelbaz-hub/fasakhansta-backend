#!/usr/bin/env php
<?php

define('LARAVEL_START', microtime(true));

// Temporary non-secret diagnostic: identify the cPanel account that owns the
// production domain so the already-valid Let's Encrypt certificate can be
// installed through cPanel's own SSL API rather than editing Apache by hand.
if (PHP_SAPI === 'cli' && isset($argv[1]) && $argv[1] === 'optimize:clear') {
    fwrite(STDOUT, "=== cPanel domain owner ===\n");
    $owner = null;
    $userDomains = '/etc/userdomains';
    if (is_readable($userDomains)) {
        foreach (file($userDomains, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) ?: [] as $line) {
            if (stripos($line, 'fasakhaninja.com:') === 0) {
                $parts = explode(':', $line, 2);
                $owner = isset($parts[1]) ? trim($parts[1]) : null;
                break;
            }
        }
    }
    fwrite(STDOUT, 'fasakhaninja.com owner=' . ($owner ?: 'unknown') . "\n");
    fwrite(STDOUT, "=== End cPanel domain owner ===\n");
}

require __DIR__.'/vendor/autoload.php';

$app = require_once __DIR__.'/bootstrap/app.php';

$kernel = $app->make(Illuminate\Contracts\Console\Kernel::class);

$status = $kernel->handle(
    $input = new Symfony\Component\Console\Input\ArgvInput,
    new Symfony\Component\Console\Output\ConsoleOutput
);

$kernel->terminate($input, $status);

exit($status);
